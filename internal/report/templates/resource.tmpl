{{/* 资源指标模板 */}}

{{/* 每小时资源指标 */}}
{{define "hourly_resource"}}
  📈 每日报表 - 每小时资源指标趋势

  【报告周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无小时级别指标数据）
{{end}}{{end}}

{{/* 每日资源指标 */}}
{{define "daily_resource"}}
  📈 {{.Title}} - 每日资源指标趋势

  【报告周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无日级别指标数据）
{{end}}{{end}}

{{/* 月度资源指标 */}}
{{define "monthly_resource"}}
  📈 年度报表 - 月度资源指标趋势

  【报告周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无月级别指标数据）
{{end}}{{end}}

{{/* 每日报告完整模板 */}}
{{define "daily"}}
{{template "base" .Base}}
{{if .HasHourly}}
{{template "hourly_resource" .Hourly}}
{{end}}{{end}}

{{/* 每周报告完整模板 */}}
{{define "weekly"}}
{{template "base" .Base}}
{{if .HasDaily}}
{{template "daily_resource" .Daily}}
{{end}}{{end}}

{{/* 每月报告完整模板 */}}
{{define "monthly"}}
{{template "base" .Base}}
{{if .HasDaily}}
{{template "daily_resource" .Daily}}
{{end}}{{end}}

{{/* 年度报告完整模板 */}}
{{define "yearly"}}
{{template "base" .Base}}
{{if .HasMonthly}}
{{template "monthly_resource" .Monthly}}
{{end}}{{end}}