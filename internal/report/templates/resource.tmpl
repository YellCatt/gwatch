{{/* 资源指标模板 - 手机适配版 */}}

{{/* 每小时资源指标 */}}
{{define "hourly_resource"}}
📈 每小时资源指标趋势
【周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无小时级别指标数据）
{{end}}{{end}}

{{/* 每日资源指标 */}}
{{define "daily_resource"}}
📈 {{.Title}} - 每日资源指标趋势
【周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无日级别指标数据）
{{end}}{{end}}

{{/* 月度资源指标 */}}
{{define "monthly_resource"}}
📈 年度报表 - 月度资源指标趋势
【周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无月级别指标数据）
{{end}}{{end}}

{{/* 系统资源状态 */}}
{{define "system_status"}}
🖥️ 系统资源状态
  CPU:  当前 {{printf "%.2f" .CPUPercent}}% | 历史最高 {{printf "%.2f" .CPUMaxPercent}}%
  内存: 当前 {{printf "%.2f" .MemoryPercent}}% | 历史最高 {{printf "%.2f" .MemoryMaxPercent}}% ({{formatBytes .MemUsedBytes}} / {{formatBytes .MemTotalBytes}})
  磁盘: {{printf "%.2f" .DiskPercent}}% ({{formatBytes .DiskUsedBytes}} / {{formatBytes .DiskTotalBytes}})
  网络下行: 当前 {{formatSpeed .NetDownKBps}} | 历史最高 {{formatSpeed .NetDownMaxKBps}}
  网络上行: 当前 {{formatSpeed .NetUpKBps}} | 历史最高 {{formatSpeed .NetUpMaxKBps}}
{{if .Partitions}}
  各分区:
{{range .Partitions}}    {{.MountPoint}} ({{.Fstype}}): {{printf "%.2f" .Percent}}% ({{formatBytes .UsedBytes}} / {{formatBytes .TotalBytes}})
{{end}}{{end}}
{{if .CPUChart}}
📈 系统资源趋势 ({{.StartTime}} ~ {{.EndTime}})
  【CPU 使用率 - 平均值趋势】
{{.CPUChart}}
  【CPU 使用率 - 最高值趋势】
{{.CPUMaxChart}}
  【内存使用率 - 平均值趋势】
{{.MemoryChart}}
  【内存使用率 - 最高值趋势】
{{.MemoryMaxChart}}
  【磁盘使用率趋势】
{{.DiskChart}}
  【网络下行速度 - 平均值趋势】
{{.NetDownChart}}
  【网络下行速度 - 最高值趋势】
{{.NetDownMaxChart}}
  【网络上行速度 - 平均值趋势】
{{.NetUpChart}}
  【网络上行速度 - 最高值趋势】
{{.NetUpMaxChart}}
{{end}}
{{end}}

{{/* 每日报告完整模板 */}}
{{define "daily"}}
{{template "base" .Base}}
{{if .HasSystemStatus}}
{{template "system_status" .SystemStatus}}
{{end}}
{{if .HasHourly}}
{{template "hourly_resource" .Hourly}}
{{end}}
来自 gwatch 运维监控系统
{{end}}

{{/* 每周报告完整模板 */}}
{{define "weekly"}}
{{template "base" .Base}}
{{if .HasSystemStatus}}
{{template "system_status" .SystemStatus}}
{{end}}
{{if .HasDaily}}
{{template "daily_resource" .Daily}}
{{end}}
来自 gwatch 运维监控系统
{{end}}

{{/* 每月报告完整模板 */}}
{{define "monthly"}}
{{template "base" .Base}}
{{if .HasSystemStatus}}
{{template "system_status" .SystemStatus}}
{{end}}
{{if .HasDaily}}
{{template "daily_resource" .Daily}}
{{end}}
来自 gwatch 运维监控系统
{{end}}

{{/* 年度报告完整模板 */}}
{{define "yearly"}}
{{template "base" .Base}}
{{if .HasSystemStatus}}
{{template "system_status" .SystemStatus}}
{{end}}
{{if .HasMonthly}}
{{template "monthly_resource" .Monthly}}
{{end}}
来自 gwatch 运维监控系统
{{end}}