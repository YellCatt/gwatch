{{/* 资源指标模板 - 手机适配版 */}}

{{/* 每小时资源指标 */}}
{{define "hourly_resource"}}


📈 每小时资源指标趋势
【周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无小时级别指标数据）
{{end}}{{end}}

{{/* 每日资源指标 */}}
{{define "daily_resource"}}


📈 {{.Title}} - 每日资源指标趋势
【周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无日级别指标数据）
{{end}}{{end}}

{{/* 月度资源指标 */}}
{{define "monthly_resource"}}


📈 年度报表 - 月度资源指标趋势
【周期】{{.StartDate}} ~ {{.EndDate}}
{{- if .Charts}}
{{range .Charts}}{{.}}
{{end}}{{else}}  （无月级别指标数据）
{{end}}{{end}}

{{/* 系统资源状态 */}}
{{define "system_status"}}


🖥️ 系统资源状态
  CPU:  {{printf "%.2f" .CPUPercent}}%
  内存: {{printf "%.2f" .MemoryPercent}}% ({{formatBytes .MemUsedBytes}} / {{formatBytes .MemTotalBytes}})
  磁盘: {{printf "%.2f" .DiskPercent}}% ({{formatBytes .DiskUsedBytes}} / {{formatBytes .DiskTotalBytes}})
  网络: ↓{{printf "%.2f" .NetDownKBps}} KB/s  ↑{{printf "%.2f" .NetUpKBps}} KB/s

{{if .CPUChart}}
📈 系统资源趋势 (过去24小时)

  【CPU 使用率趋势】
{{.CPUChart}}
  【内存使用率趋势】
{{.MemoryChart}}
  【磁盘使用率趋势】
{{.DiskChart}}
  【网络下行速度趋势】
{{.NetDownChart}}
  【网络上行速度趋势】
{{.NetUpChart}}
{{end}}
{{end}}

{{/* 每日报告完整模板 */}}
{{define "daily"}}
{{template "base" .Base}}
{{if .HasSystemStatus}}
{{template "system_status" .SystemStatus}}
{{end}}
{{if .HasHourly}}
{{template "hourly_resource" .Hourly}}
{{end}}
来自 gwatch 运维监控系统
{{end}}

{{/* 每周报告完整模板 */}}
{{define "weekly"}}
{{template "base" .Base}}
{{if .HasDaily}}
{{template "daily_resource" .Daily}}
{{end}}
来自 gwatch 运维监控系统
{{end}}

{{/* 每月报告完整模板 */}}
{{define "monthly"}}
{{template "base" .Base}}
{{if .HasDaily}}
{{template "daily_resource" .Daily}}
{{end}}
来自 gwatch 运维监控系统
{{end}}

{{/* 年度报告完整模板 */}}
{{define "yearly"}}
{{template "base" .Base}}
{{if .HasMonthly}}
{{template "monthly_resource" .Monthly}}
{{end}}
来自 gwatch 运维监控系统
{{end}}