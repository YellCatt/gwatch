{{/* 基础报告模板 - 手机适配版 */}}
{{define "base"}}
gwatch {{.Period}}运维报告

【周期】{{.StartDate}} ~ {{.EndDate}}
【生成】{{formatDateTime .GeneratedAt}}
【设备】{{deviceName}}

━━━━━━━━━━━━━━━━━━━━━━━━

📊 执行概览

  总次数:  {{.TotalTasks}}
  成功:    {{.SuccessTasks}}
  失败:    {{.FailedTasks}}
  成功率:  {{printf "%.2f" .SuccessRate}}%
  平均耗时: {{.AvgDuration}}

━━━━━━━━━━━━━━━━━━━━━━━━

🔧 接口状态

{{- if .InterfaceStats}}
{{range .InterfaceStats}}{{if .HasFailure}}⚠️{{else}}✅{{end}} {{.TaskID}}
    请求: {{.TotalCount}}次  成功: {{.SuccessCount}}  失败: {{.FailedCount}}
    平均: {{.AvgDuration}}  最大: {{.MaxDuration}}

{{end}}{{else}}  暂无接口数据
{{end}}
━━━━━━━━━━━━━━━━━━━━━━━━

📢 告警汇总

{{- if .AggregatedErrors}}
{{range .AggregatedErrors}}▸ {{.Icon}} 【{{.Level}}】{{.TaskID}}
  {{.TaskDesc}}
  {{.Method}} {{.URL}}
  期望状态码: {{.ExpectedStatus}}
  告警次数: {{.AlertCount}} 次
  首次: {{.FirstOccurrence}}
  最近: {{.LastOccurrence}}
  信息: {{.ErrorMsg}}

{{end}}──────────────────────────────
  合计: CRITICAL {{.CriticalAlertCount}} 项
        WARNING {{.WarningAlertCount}} 项
        共 {{.TotalAlertCount}} 项告警
{{else}}  ✅ 无告警
{{end}}
来自 gwatch 接口监控系统
{{end}}