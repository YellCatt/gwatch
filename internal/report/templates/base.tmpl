{{/* 基础报告模板 - 手机适配版 */}}
{{define "base"}}
gwatch {{.Period}}运维报告

【周期】{{.StartDate}} ~ {{.EndDate}}
【生成】{{formatDateTime .GeneratedAt}}
【设备】{{deviceName}}

━━━━━━━━━━━━━━━━━━━━━━━━

📊 执行概览

  总次数:  {{.TotalTasks}}
  成功:    {{.SuccessTasks}}
  失败:    {{.FailedTasks}}
  成功率:  {{printf "%.2f" .SuccessRate}}%
  平均耗时: {{.AvgDuration}}

━━━━━━━━━━━━━━━━━━━━━━━━

🔧 接口状态

{{- if .InterfaceStats}}
{{range .InterfaceStats}}{{if .HasFailure}}⚠️{{else}}✅{{end}} {{.TaskID}}
    请求: {{.TotalCount}}次  成功: {{.SuccessCount}}  失败: {{.FailedCount}}
    平均: {{.AvgDuration}}  最大: {{.MaxDuration}}

{{end}}{{else}}  暂无接口数据
{{end}}
━━━━━━━━━━━━━━━━━━━━━━━━

📢 告警汇总

{{- if .AggregatedErrors}}
{{range .AggregatedErrors}}▸ {{.Icon}} 【{{.Level}}】{{.TaskID}}
  {{.TaskDesc}}
  {{.Method}} {{.URL}}
  期望状态码: {{.ExpectedStatus}}
  告警次数: {{.AlertCount}} 次
  首次: {{.FirstOccurrence}}
  最近: {{.LastOccurrence}}
  信息: {{.ErrorMsg}}

{{end}}──────────────────────────────
  接口告警: CRITICAL {{.CriticalAlertCount}} 项
        WARNING {{.WarningAlertCount}} 项
        共 {{.TotalAlertCount}} 项
{{else}}  ✅ 接口监控无告警
{{end}}

{{- if .SystemAlerts}}
━━━━━━━━━━━━━━━━━━━━━━━━
🖥️ 系统资源告警

{{range .SystemAlerts}}▸ {{.Icon}} 【{{.Level}}】{{.Metric}}
  当前值: {{.Value}} {{.Unit}}  阈值: {{.Threshold}} {{.Unit}}
  告警次数: {{.AlertCount}} 次
  首次: {{.FirstOccurrence}}
  最近: {{.LastOccurrence}}
  信息: {{.Message}}

{{end}}──────────────────────────────
  系统告警: CRITICAL {{.SystemCriticalCount}} 项
        WARNING {{.SystemWarningCount}} 项
        共 {{.SystemAlertTotal}} 项
{{end}}

{{- if .ScraperAlerts}}
━━━━━━━━━━━━━━━━━━━━━━━━
🔍 远程资源告警

{{range .ScraperAlerts}}▸ {{.Icon}} 【{{.Level}}】{{.TargetName}} - {{.MetricName}}
  目标: {{.TargetURL}}
  当前值: {{.Value}} {{.Unit}}  阈值: {{.Threshold}} {{.Unit}}
  告警次数: {{.AlertCount}} 次
  首次: {{.FirstOccurrence}}
  最近: {{.LastOccurrence}}
  信息: {{.Message}}

{{end}}──────────────────────────────
  采集告警: CRITICAL {{.ScraperCriticalCount}} 项
        WARNING {{.ScraperWarningCount}} 项
        共 {{.ScraperAlertTotal}} 项
{{end}}

{{- if or .SystemAlerts .ScraperAlerts}}
━━━━━━━━━━━━━━━━━━━━━━━━
{{end}}

{{- if and (not .AggregatedErrors) (not .SystemAlerts) (not .ScraperAlerts)}}
  ✅ 全部监控系统无告警
{{end}}

来自 gwatch 运维监控系统
{{end}}