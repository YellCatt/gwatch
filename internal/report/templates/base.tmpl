{{/* 基础报告模板 - 手机适配版 */}}
{{define "base"}}
gwatch {{.Period}}运维报告

【周期】{{.StartDate}} ~ {{.EndDate}}
【生成】{{formatDateTime .GeneratedAt}}
【设备】{{deviceName}}

📊 执行概览
  总次数:  {{.TotalTasks}}
  成功:    {{.SuccessTasks}}
  失败:    {{.FailedTasks}}
  成功率:  {{printf "%.2f" .SuccessRate}}%
  平均耗时: {{.AvgDuration}}

🔧 接口状态
{{- if .InterfaceStats}}
{{range .InterfaceStats}}{{if .HasFailure}}⚠️{{else}}✅{{end}} {{.TaskID}}
    请求: {{.TotalCount}}次  成功: {{.SuccessCount}}  失败: {{.FailedCount}}{{if gt .AlertCount 0}}  告警: {{.AlertCount}}次{{end}}
    平均: {{.AvgDuration}}  最大: {{.MaxDuration}}

{{end}}{{else}}  暂无接口数据
{{end}}

📢 告警汇总
{{- if .AggregatedErrors}}
{{range .AggregatedErrors}}▸ {{.Icon}} 【{{.Level}}】{{.TaskID}}
  {{.TaskDesc}}
  {{.Method}} {{.URL}}
  期望状态码: {{.ExpectedStatus}}
  告警次数: {{.AlertCount}} 次
  首次: {{.FirstOccurrence}}
  最近: {{.LastOccurrence}}
  信息: {{.ErrorMsg}}

{{end}}
  接口告警: 严重 {{.CriticalAlertCount}} 项{{if gt .WarningAlertCount 0}}, 警告 {{.WarningAlertCount}} 项{{end}}, 共 {{.TotalAlertCount}} 项
{{else}}  ✅ 接口监控无告警
{{end}}

{{- if .SystemAlerts}}
🖥️ 系统资源告警
{{range .SystemAlerts}}▸ {{.Icon}} 【{{.Level}}】{{.Metric}}
  当前值: {{.Value}}  阈值: {{.Threshold}}
  告警次数: {{.AlertCount}} 次
  首次: {{.FirstOccurrence}}
  最近: {{.LastOccurrence}}
  信息: {{.Message}}

{{end}}
  系统告警: 严重 {{.SystemCriticalCount}} 项{{if gt .SystemWarningCount 0}}, 警告 {{.SystemWarningCount}} 项{{end}}, 共 {{.SystemAlertTotal}} 项
{{end}}

{{- if .ScraperAlerts}}
🔍 远程资源告警
{{range .ScraperAlerts}}▸ {{.Icon}} 【{{.Level}}】{{.TargetName}} - {{.MetricName}}
  目标: {{.TargetURL}}
  当前值: {{.Value}}  阈值: {{.Threshold}}
  告警次数: {{.AlertCount}} 次
  首次: {{.FirstOccurrence}}
  最近: {{.LastOccurrence}}
  信息: {{.Message}}

{{end}}
  采集告警: 严重 {{.ScraperCriticalCount}} 项{{if gt .ScraperWarningCount 0}}, 警告 {{.ScraperWarningCount}} 项{{end}}, 共 {{.ScraperAlertTotal}} 项
{{end}}

{{- if and (not .AggregatedErrors) (not .SystemAlerts) (not .ScraperAlerts)}}
  ✅ 全部监控系统无告警
{{end}}
{{end}}