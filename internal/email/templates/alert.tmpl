{{/* 统一告警邮件模板 */}}
{{define "unified_alert"}}

告警时间: {{.Timestamp}}
监控设备: {{.DeviceName}}
告警数量: {{.TotalCount}} (严重:{{.CriticalCount}} 警告:{{.WarningCount}})

{{range .Groups}}
━━━ {{.SourceName}} ━━━
{{range .Alerts}}{{if eq .Level "CRITICAL"}}🚨{{else}}⚠️{{end}} [{{.Level}}] {{.MetricAlias}}
   目标:     {{.TargetName}}
{{- if ne .Value 0.0}}
   当前值:   {{formatValue .Value .Unit}}
{{- end}}
{{- if gt .Threshold 0.0}}
   阈值:     {{formatValue .Threshold .Unit}}
{{- end}}
{{- if .Message}}
   消息:     {{.Message}}
{{- end}}

{{end}}{{end}}

{{end}}